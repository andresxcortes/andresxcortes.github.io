---
import { contextLine, typeLabels, type CaseStudy } from '../lib/case-studies';

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { type, title, summary, outcome, draft, role, authors, status } = entry.data;
const context = contextLine(entry.data);
const byline = role ?? (authors ? authors.join(', ') : undefined);
---

<article class="card" data-type={type}>
  <p class="meta">
    {draft && <span class="draft">Draft</span>}
    <span class="type">{typeLabels[type]}</span>
    {status && <span> · {status}</span>}
    {context && <span> · {context}</span>}
  </p>
  {byline && <p class="byline">{byline}</p>}
  <h3><a href={`/portfolio/${entry.id}/`}>{title}</a></h3>
  <p class="summary">{summary}</p>
  {outcome && <p class="outcome"><strong>Outcome:</strong> {outcome}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--tag-fg);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    --tag-bg: var(--tint);
    --tag-fg: var(--accent);
  }

  /* One colour family per entry type, shared by the tag and the card's top rule. */
  .card[data-type='engagement'] { --tag-bg: #1f2a44; --tag-fg: #1f2a44; --tag-ink: #fff; }
  .card[data-type='research'] { --tag-bg: #f1e7d3; --tag-fg: #a8874f; --tag-ink: #5c4519; }
  .card[data-type='resource'] { --tag-bg: #dcefea; --tag-fg: #2a8071; --tag-ink: #14554a; }
  .card[data-type='project'] { --tag-bg: #ebe3f3; --tag-fg: #7a5aa6; --tag-ink: #46285f; }
  .card[data-type='note'] { --tag-bg: #e1e9f6; --tag-fg: #3f6bb0; --tag-ink: #1f3f75; }

  .card:hover {
    background: var(--tint);
  }

  .meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .type {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--tag-bg);
    color: var(--tag-ink, var(--accent-dark));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.74rem;
  }

  .byline {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-dark);
  }

  .draft {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0 0.4rem;
    border-radius: 3px;
    background: #8a5a00;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  h3 a {
    color: var(--accent-dark);
    text-decoration: none;
  }

  /* Whole card is clickable */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    margin: 0;
  }

  .summary {
    flex-grow: 1;
  }

  .outcome {
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .outcome strong {
    color: var(--accent-dark);
  }
</style>
