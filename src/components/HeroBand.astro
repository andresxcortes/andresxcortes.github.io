---
import HeroArt from './HeroArt.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** Show the decorative illustration (home page only). */
  art?: boolean;
}

const { title, subtitle, art = false } = Astro.props;
---

<section class="hero">
  <div class={art ? 'container with-art' : 'container'}>
    <div class="copy">
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <slot />
    </div>
    {art && <div class="figure"><HeroArt /></div>}
  </div>
</section>

<style>
  .hero {
    background: var(--band);
    border-bottom: 3px solid var(--accent);
    color: #fff;
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
  }

  .with-art {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .figure {
    display: none;
  }

  @media (min-width: 900px) {
    .with-art {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }

    .figure {
      display: block;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.25rem);
  }

  .subtitle {
    margin: 0.75rem 0 0;
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.2rem);
    opacity: 0.92;
  }

  .hero :global(p.lead) {
    max-width: 62ch;
    margin: 1.5rem 0 0;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
  }
</style>
