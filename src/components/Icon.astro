---
// Outline icons from Tabler Icons (MIT, https://tabler.io/icons), inlined so no external requests.
interface Props {
  name: 'mail' | 'linkedin';
  size?: number;
}

const { name, size = 20 } = Astro.props;

const paths: Record<Props['name'], string[]> = {
  mail: [
    'M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z',
    'M3 7l9 6l9 -6',
  ],
  linkedin: [
    'M8 11v5',
    'M8 8v.01',
    'M12 16v-5',
    'M16 16v-3a2 2 0 1 0 -4 0',
    'M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10',
  ],
};
---

<svg
  class="icon"
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    flex-shrink: 0;
    vertical-align: -0.2em;
  }
</style>
