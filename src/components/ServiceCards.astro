---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<ul class="grid">
  {
    services.map((s) => (
      <li class="card" id={s.slug}>
        {s.icon && (
          <span class="glyph">
            <Icon name={s.icon} size={24} />
          </span>
        )}
        <h2>{s.title}</h2>
        <p>{s.description}</p>
        {s.link && <a href={s.link.href}>{s.link.label}</a>}
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.25rem 1.5rem 1.4rem;
    scroll-margin-top: 5rem;
  }

  .card:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(76, 159, 255, 0.25);
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.9rem;
    border-radius: 10px;
    background: var(--band);
    color: var(--accent-soft);
  }

  h2 {
    margin: 0 0 0.5rem;
    color: var(--accent-dark);
    font-size: 1.15rem;
  }

  p {
    margin: 0;
  }

  a {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
