---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  services: Service[];
}

const tiles = Astro.props.services.filter((s) => s.slug && s.icon);
---

<ul class="tiles">
  {
    tiles.map((s) => (
      <li>
        <a class="tile" href={`/services/#${s.slug}`}>
          <span class="glyph">
            <Icon name={s.icon!} size={26} />
          </span>
          <span class="body">
            <strong>{s.title}</strong>
            <span class="blurb">{s.blurb}</span>
          </span>
          <span class="go" aria-hidden="true">
            <Icon name="arrow" size={18} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    height: 100%;
    padding: 1.25rem 1.25rem 1.25rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--accent-dark);
    text-decoration: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .tile:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 8px 22px -12px rgba(0, 0, 0, 0.5);
    text-decoration: none;
  }

  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    background: var(--band);
    color: var(--accent-soft);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-right: 1.5rem;
  }

  strong {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    line-height: 1.3;
  }

  .blurb {
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.45;
  }

  .go {
    position: absolute;
    right: 1.1rem;
    top: 1.35rem;
    color: var(--accent);
    transition: transform 0.18s ease;
  }

  .tile:hover .go {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .go {
      transition: none;
    }
    .tile:hover,
    .tile:hover .go {
      transform: none;
    }
  }
</style>
