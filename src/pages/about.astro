---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="About — Andrés Cortés"
  description="Information security and technical program leader — 10+ years across crypto, fintech, and global banking."
>
  <HeroBand title="About" subtitle="Virtual CISO & Security Advisory · Fintech & Crypto · Latin America" />

  <div class="container">
    <section class="section prose">
      <p class="intro">
        Information security and technical program leader with 10+ years delivering complex,
        regulated initiatives across crypto, fintech, and global banking.
      </p>
      <p>
        Through 2026 I was <strong>Argentina CISO and Information Security PMO Manager at Bitso</strong>
        — Latin America's largest crypto exchange — owning security strategy for the regulated
        Argentine operation, acting as the designated security contact to Argentine regulators (CNV,
        UIF, BCRA, AAIP), and co-running a portfolio of 60+ concurrent GRC initiatives with a 15+
        person team. I led VASP compliance (CNV RG 1058/2025) and contributed to ISO 27001
        certification (2025), SOC 2, and the firm's data-privacy framework.
      </p>
      <p>
        Before Bitso I was a Product Owner at <strong>JPMorgan Chase</strong> (Corporate &amp;
        Investment Banking and Legal Solutions) and held product and analyst roles across First
        Data, Globant, and others — a background that means I understand the business the security
        function has to protect.
      </p>
      <p>
        Now I bring that experience to fintech and crypto teams as a
        <strong>fractional CISO and advisor</strong>.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Credentials</h2>
      <dl class="creds">
        <div>
          <dt>Certifications</dt>
          <dd>
            CISM · PMP · ISC2 CC · CSPO · Google Cloud Digital Leader · AWS Certified Cloud
            Practitioner (in progress)
          </dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>
            <ul>
              <li>MSc, Cyber Defence &amp; Cybersecurity (UBA)</li>
              <li>Postgraduate Diploma, Project Management (UTN FRBA)</li>
              <li>BSc, Information Systems (UBA)</li>
            </ul>
          </dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>
            Spanish (native) · English (C2) · Portuguese (B2) · German (B1) — cross-border by
            default.
          </dd>
        </div>
      </dl>
    </section>
  </div>

  <CtaBand heading="Work with me" />
</BaseLayout>

<style>
  .intro {
    font-size: 1.15em;
    color: var(--accent-dark);
  }

  .creds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
    margin: 0;
  }

  .creds > div {
    background: var(--card);
    border-left: 4px solid var(--accent);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
  }

  dt {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--accent-dark);
    margin-bottom: 0.5rem;
  }

  dd {
    margin: 0;
  }

  dd ul {
    margin: 0;
    padding-left: 1.1em;
  }
</style>
