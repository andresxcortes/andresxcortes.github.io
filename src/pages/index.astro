---
const title = 'Andrés Cortés — Virtual CISO & Security Advisory';
const description =
  'Fractional CISO and security advisory for fintech and crypto teams across Latin America.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="hero">
      <h1>Andrés Cortés</h1>
      <p>Virtual CISO &amp; Security Advisory · Fintech &amp; Crypto · Latin America</p>
    </header>
    <main>
      <p>New site coming soon.</p>
    </main>
  </body>
</html>

<style>
  :root {
    --accent: #0e5c63;
    --ink: #1a1a1a;
    --muted: #5a5a5a;
    --bg: #ffffff;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.55;
  }
  .hero {
    background: var(--accent);
    color: #fff;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .hero p {
    margin: 0;
    opacity: 0.9;
  }
  main {
    max-width: 68ch;
    margin: 3rem auto;
    padding: 0 1.5rem;
    text-align: center;
    color: var(--muted);
  }
</style>
