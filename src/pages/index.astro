---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { markets } from '../data/regulatory';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCaseStudies } from '../lib/case-studies';

const featured = (await getCaseStudies()).filter((c) => c.data.featured).slice(0, 2);
---

<BaseLayout
  title="Andrés Cortés — Virtual CISO & Security Advisory"
  description="Fractional CISO and security advisory for fintech and crypto teams across Latin America — regulatory, GRC, and audit-ready security."
>
  <HeroBand
    title="Andrés Cortés"
    subtitle="Virtual CISO & Security Advisory · Fintech & Crypto · Latin America"
  >
    <p class="lead">
      I help fintech and crypto companies build security and compliance functions that satisfy
      regulators and pass audits — without slowing the business down.
    </p>
  </HeroBand>

  <div class="container">
    <section class="section prose">
      <p>
        Most recently Argentina CISO at <strong>Bitso</strong>, Latin America's largest crypto
        exchange, I ran security governance and a portfolio of 60+ concurrent GRC initiatives at
        exchange scale, with direct, working relationships across Argentine regulators. I bring that
        same rigor to your team on a fractional basis, with hands-on depth
        across <strong>Argentina, Mexico, and Brazil</strong>.
      </p>
      <ul class="link-row">
        <li><a href="/services">See services →</a></li>
        <li><a href="/regulatory-coverage">Regulatory coverage →</a></li>
        <li><a href="/contact">Let's talk →</a></li>
      </ul>
    </section>

    <section class="section">
      <h2 class="section-title">What I bring</h2>
      <ul class="prose">
        <li>Exchange-scale security governance and GRC.</li>
        <li>Live experience with LatAm fintech &amp; crypto regulation (AR / MX / BR).</li>
        <li>ISO 27001 &amp; SOC 2 delivery, data-privacy programs, VASP/AML compliance.</li>
        <li>Hands-on incident response, not just slideware.</li>
      </ul>
      <p class="muted certs">
        Certifications: CISM · PMP · ISC2 CC · CSPO · Google Cloud Digital Leader (AWS Certified
        Cloud Practitioner in progress).
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Services</h2>
      <ul class="teaser-list">
        {services.map((s) => <li>{s.title}</li>)}
      </ul>
      <p><a class="more" href="/services">All services and engagement models →</a></p>
    </section>

    <section class="section">
      <h2 class="section-title">Regulatory coverage</h2>
      <p class="prose">
        Fintech, crypto/VASP, AML/CFT, and data-protection frameworks across the region's three
        defining markets.
      </p>
      <ul class="markets">
        {
          markets.map((m) => (
            <li>
              <a href="/regulatory-coverage">{m.name}</a>
            </li>
          ))
        }
      </ul>
      <p><a class="more" href="/regulatory-coverage">See the full matrix →</a></p>
    </section>

    {
      featured.length > 0 && (
        <section class="section">
          <h2 class="section-title">Selected work</h2>
          <ul class="featured">
            {featured.map((entry) => (
              <li>
                <CaseStudyCard entry={entry} />
              </li>
            ))}
          </ul>
          <p>
            <a class="more" href="/portfolio">All case studies →</a>
          </p>
        </section>
      )
    }
  </div>

  <CtaBand />
</BaseLayout>

<style>
  .certs {
    font-size: 0.95rem;
    margin-top: 1.5rem;
  }

  .teaser-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .teaser-list li {
    background: var(--card);
    border-left: 4px solid var(--accent);
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--accent-dark);
  }

  .markets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .markets a {
    display: block;
    padding: 0.6rem 1.25rem;
    background: var(--tint);
    color: var(--accent-dark);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
  }

  .markets a:hover {
    background: var(--line);
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }
</style>
