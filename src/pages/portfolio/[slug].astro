---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBand from '../../components/HeroBand.astro';
import CtaBand from '../../components/CtaBand.astro';
import {
  contextLine,
  formatDate,
  getCaseStudies,
  typeLabels,
  type CaseStudy,
} from '../../lib/case-studies';

export async function getStaticPaths() {
  const cases = await getCaseStudies();
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { type, title, services, summary, outcome, date, draft, role, authors, status, language } =
  entry.data;
const subtitle = [type === 'engagement' ? undefined : typeLabels[type], status, contextLine(entry.data)]
  .filter(Boolean)
  .join(' · ');
const hasFacts = Boolean(outcome || role || authors || services.length || date || language);
const { Content } = await render(entry);
---

<BaseLayout title={`${title} — Andrés Cortés`} description={summary} type="article">
  <HeroBand title={title} subtitle={subtitle} />

  <div class="container">
    {draft && <p class="draft-note">Draft — visible only in local dev, not published.</p>}

    {hasFacts && (
    <section class="section">
      <dl class="facts">
        {
          outcome && (
            <div>
              <dt>Outcome</dt>
              <dd>{outcome}</dd>
            </div>
          )
        }
        {
          role && (
            <div>
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
          )
        }
        {
          authors && (
            <div>
              <dt>Authors</dt>
              <dd>{authors.join(', ')}</dd>
            </div>
          )
        }
        {
          services.length > 0 && (
            <div>
              <dt>Areas</dt>
              <dd>
                <ul class="tags">
                  {services.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          date && (
            <div>
              <dt>Date</dt>
              <dd>{formatDate(date)}</dd>
            </div>
          )
        }
        {
          language && (
            <div>
              <dt>Language</dt>
              <dd>{language}</dd>
            </div>
          )
        }
      </dl>
    </section>
    )}

    <section class="section">
      <div class="prose case-body">
        <Content />
      </div>
      <p><a class="back" href="/portfolio/">← All work</a></p>
    </section>
  </div>

  <CtaBand heading="Facing a similar challenge?" />
</BaseLayout>

<style>
  .draft-note {
    margin: 1.5rem 0 0;
    padding: 0.6rem 1rem;
    border-left: 4px solid #8a5a00;
    background: #fdf6e8;
    font-size: 0.9rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
    margin: 0;
  }

  .facts > div {
    background: var(--card);
    border-left: 4px solid var(--accent);
    border-radius: 4px;
    padding: 1rem 1.25rem;
  }

  dt {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--accent-dark);
    margin-bottom: 0.35rem;
  }

  dd {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.1rem 0.55rem;
    background: var(--tint);
    border-radius: 3px;
    font-size: 0.85rem;
  }

  .case-body :global(h2) {
    color: var(--accent);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent);
  }

  .case-body :global(h2:first-child) {
    margin-top: 0;
  }

  /* Markdown tables (e.g. crosswalk samples) get the matrix treatment and may be wider than the text column */
  .case-body :global(table) {
    display: block;
    width: min(calc(var(--max-width) - 2 * var(--gutter)), calc(100vw - 2 * var(--gutter)));
    max-width: none;
    overflow-x: auto;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .case-body :global(th) {
    background: var(--accent);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    text-align: left;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--accent);
  }

  .case-body :global(td) {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    vertical-align: top;
    min-width: 9rem;
  }

  .case-body :global(td:first-child) {
    background: var(--tint);
    min-width: 5.5rem;
    white-space: nowrap;
  }

  .case-body :global(h3) {
    color: var(--accent-dark);
    margin: 1.5rem 0 0.5rem;
  }

  .back {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
  }
</style>
