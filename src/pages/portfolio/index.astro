---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBand from '../../components/HeroBand.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCaseStudies } from '../../lib/case-studies';

const cases = await getCaseStudies();
---

<BaseLayout
  title="Portfolio — Andrés Cortés"
  description="Anonymized case studies in security, GRC, and regulatory compliance for fintech and crypto across Latin America."
>
  <HeroBand title="Portfolio" subtitle="Selected engagements · Fintech & Crypto · Latin America">
    <p class="lead">
      Case studies are anonymized by default: sector, stage, and outcome — never client names or
      confidential detail.
    </p>
  </HeroBand>

  <div class="container">
    <section class="section">
      {
        cases.length > 0 ? (
          <ul class="grid">
            {cases.map((entry) => (
              <li>
                <CaseStudyCard entry={entry} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">Case studies are being prepared and will be published here soon.</p>
        )
      }
    </section>
  </div>

  <CtaBand />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
