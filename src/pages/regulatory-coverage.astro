---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import RegulatoryMatrix from '../components/RegulatoryMatrix.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="LatAm Regulatory Coverage — Fintech & Crypto | Andrés Cortés"
  description="The specific fintech, crypto/VASP, AML/CFT, and data-protection frameworks I work within across Argentina, Mexico, and Brazil."
>
  <HeroBand title="LatAm Regulatory Coverage" subtitle="Fintech & Crypto · Argentina · Mexico · Brazil">
    <p class="lead">
      The specific frameworks I work within across the region's three defining markets.
    </p>
  </HeroBand>

  <div class="wide">
    <section class="section">
      <RegulatoryMatrix />
      <p class="muted note">
        Regulatory landscape as of 2026; frameworks in Argentina, Mexico, and Brazil continue to
        evolve.
      </p>
    </section>
  </div>

  <div class="container">
    <section class="section">
      <h2 class="section-title">How I use this</h2>
      <p class="prose">
        For each engagement I translate the relevant framework into an operational control set, an
        evidence plan, and a realistic timeline — the same way I delivered Argentina's VASP
        framework (CNV RG 1058/2025) and ISO 27001 at exchange scale.
      </p>
    </section>
  </div>

  <CtaBand heading="Discuss your market">
    <p>Tell me where you operate and what you need to get licensed, registered, or audit-ready.</p>
  </CtaBand>
</BaseLayout>

<style>
  /* The matrix gets a little more room than the reading column */
  .wide {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .note {
    font-size: 0.85rem;
    margin-top: 1rem;
  }
</style>
