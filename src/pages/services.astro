---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import ServiceCards from '../components/ServiceCards.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Services — Andrés Cortés"
  description="vCISO, LatAm regulatory & VASP compliance, ISO 27001 & SOC 2 readiness, data privacy, security PMO, and incident response readiness."
>
  <HeroBand title="Services" subtitle="Virtual CISO & Security Advisory · Fintech & Crypto · Latin America" />

  <div class="container">
    <section class="section">
      <ServiceCards services={services} />
    </section>

    <section class="section">
      <h2 class="section-title">New: security for software built with AI</h2>
      <p class="ai-lead">
        Teams are shipping products built with AI coding tools and agents. Those tools hold
        credentials, read untrusted code, and connect to outside servers, and the code they
        produce still needs a security review before release.
      </p>
      <p><a class="ai-link" href="/ai-security/">See AI security →</a></p>
    </section>

    <section class="section">
      <h2 class="section-title">Engagement models</h2>
      <ul class="models">
        <li>
          <strong>Fractional vCISO retainer</strong>
          <span class="muted">Monthly</span>
        </li>
        <li>
          <strong>Fixed-scope project</strong>
          <span class="muted">Readiness, licensing, audit</span>
        </li>
        <li>
          <strong>Advisory</strong>
          <span class="muted">Ad-hoc / board</span>
        </li>
      </ul>
    </section>
  </div>

  <CtaBand />
</BaseLayout>

<style>
  .ai-lead {
    max-width: 68ch;
    margin: 0 0 1rem;
  }

  .ai-link {
    font-weight: 600;
    text-decoration: none;
  }

  .ai-link:hover {
    text-decoration: underline;
  }

  .models {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .models li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: 4px;
  }

  .models strong {
    color: var(--accent-dark);
  }
</style>
