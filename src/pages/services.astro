---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import ServiceCards from '../components/ServiceCards.astro';
import EngagementModels from '../components/EngagementModels.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Services — Andrés Cortés"
  description="vCISO, LatAm regulatory & VASP compliance, ISO 27001 & SOC 2 readiness, data privacy, security PMO, and incident response readiness."
>
  <HeroBand title="Services" subtitle="Virtual CISO & Security Advisory · Fintech & Crypto · Latin America" />

  <div class="container">
    <section class="section">
      <ServiceCards services={services} />
    </section>

    <section class="section">
      <h2 class="section-title">New: security for software built with AI</h2>
      <p class="ai-lead">
        Teams are shipping products built with AI coding tools and agents. Those tools hold
        credentials, read untrusted code, and connect to outside servers, and the code they
        produce still needs a security review before release.
      </p>
      <p><a class="ai-link" href="/ai-security/">See AI security →</a></p>
    </section>

    <section class="section">
      <h2 class="section-title">Engagement models</h2>
      <EngagementModels />
    </section>
  </div>

  <CtaBand />
</BaseLayout>

<style>
  .ai-lead {
    max-width: 68ch;
    margin: 0 0 1rem;
  }

  .ai-link {
    font-weight: 600;
    text-decoration: none;
  }

  .ai-link:hover {
    text-decoration: underline;
  }
</style>
